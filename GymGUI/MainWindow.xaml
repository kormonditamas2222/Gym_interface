<Window x:Class="GymGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gym Reservation GUI" Height="500" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Idősávok állapota (8:00 - 20:00)" Grid.Column="0" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcTimeSlots">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="1" Margin="4" Padding="8" CornerRadius="4" Background="{Binding BackgroundColor}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeText}" FontWeight="Bold" FontSize="14" Foreground="Black"/>
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="DimGray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Header="Új foglalás rögzítése" Grid.Column="1">
            <StackPanel Margin="10">
                <Label Content="Név / Kapcsolattartó:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtContactName" Margin="0,0,0,10" Padding="4"/>

                <Label Content="Foglalás típusa:" FontWeight="SemiBold"/>
                <ComboBox x:Name="CbReservationType" Margin="0,0,0,10" Padding="4" SelectionChanged="CbReservationType_SelectionChanged">
                    <ComboBoxItem Content="Egyéni" IsSelected="True" />
                    <ComboBoxItem Content="Csoportos" />
                </ComboBox>

                <StackPanel x:Name="PanelTeamMembers" Visibility="Collapsed" Margin="0,0,0,10">
                    <Label Content="Csoporttagok (vesszővel elválasztva):" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTeamMembers" Padding="4"/>
                </StackPanel>

                <Label Content="Idősáv (óra):" FontWeight="SemiBold"/>
                <ComboBox x:Name="CbReservationTime" Margin="0,0,0,20" Padding="4" />

                <Button Content="Foglalás" Click="BtnBook_Click" 
                        Background="Green" Foreground="White" 
                        FontWeight="Bold" Padding="10" Cursor="Hand"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>